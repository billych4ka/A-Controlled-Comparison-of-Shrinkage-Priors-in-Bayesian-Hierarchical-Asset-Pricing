# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# PyCharm project files
.idea/

# Claude Code settings
.claude/

# Data (raw and processed — regenerable from source, or too large for git)
data/raw/
data/processed/

# MCMC output (large, regenerable by rerunning models)
outputs/traces/

# OS-specific junk
.DS_Store
Thumbs.db

# Jupyter checkpoints, if you end up using notebooks/
.ipynb_checkpoints/

# results: ignore large regenerable output, keep the record of what was run
results/**/*.npz
results/**/*.npy

# ...but the record of what was run is always kept. These negations are inert
# under the two rules above (which match only .npz/.npy); they are here so the
# intent survives if a broader `results/` rule is ever added.
!results/**/*.json
!results/**/*.txt
!results/**/*.md
